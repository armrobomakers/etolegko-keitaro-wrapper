# Keitaro host root, without /admin_api/v1
KEITARO_BASE_URL=https://tlgk.host
KEITARO_API_KEY=replace-with-api-key-from-keitaro-admin

# Local SQLite database. Keep the DB out of Git.
DATABASE_URL=sqlite:///./data/keitaro_wrapper.sqlite3

# Required test-task campaign naming convention.
CAMPAIGN_PREFIX=test_ryzhkov_

# Optional override if the Keitaro instance exposes a non-standard HTTP redirect action key.
KEITARO_REDIRECT_ACTION=
